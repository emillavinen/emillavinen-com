# Every environment variable the site reads, with where each value comes from.
# Copy to .env.local for local work. Never commit real values.
# The site builds and runs with all of these empty: each missing value turns
# the feature that needs it off, with one log line saying so. See SETUP.md.

# ── DISPATCH: store ──────────────────────────────────────────────────────────
# Neon Postgres. Set automatically when you add Neon from Vercel → Storage.
DATABASE_URL=
# Vercel Blob (public store). Set automatically when you add Blob from Vercel → Storage.
BLOB_READ_WRITE_TOKEN=

# ── DISPATCH: core ───────────────────────────────────────────────────────────
# Protects /api/dispatch/run. Generate: openssl rand -hex 32. Same value in Vercel and in GitHub repo secrets.
CRON_SECRET=
# The /admin password (already used by the posts admin). Generate: openssl rand -base64 24
ADMIN_PASSWORD=
# Optional: base32 secret that adds an authenticator code to the admin login (existing feature).
TOTP_SECRET=
# Encrypts stored OAuth tokens (X OAuth 2.0, Threads, LinkedIn). Generate: openssl rand -base64 32. Never change it once set.
DISPATCH_ENCRYPTION_KEY=
# Kill switch: false = the runner does nothing. Default true. Can be overridden in /admin/connections.
DISPATCH_ENABLED=true
# true = do everything except the final call to each platform, and report what would have gone out. Default true.
DRY_RUN=true
# Helsinki time when posts may go out. Default 09:00-22:00.
POSTING_WINDOW=09:00-22:00
# How many backlog (held) works a day to trickle out to platforms where they are new. Default 0 (off).
BACKLOG_DRIP_PER_DAY=0
# Daily caps per platform (defaults shown).
CAP_X=3
CAP_THREADS=3
CAP_LINKEDIN=1
CAP_BLUESKY=3
CAP_TUMBLR=3
CAP_ARENA=10
# Optional: the public origin used in posted links and OAuth callbacks. Default https://emillavinen.com
DISPATCH_SITE_URL=

# ── DISPATCH: notifications (Telegram first, else email, else log only) ──────
# From @BotFather when you create the bot (SETUP.md step 3).
TELEGRAM_BOT_TOKEN=
# Your chat id: send /start to the bot, then read it from api.telegram.org/bot<token>/getUpdates.
TELEGRAM_CHAT_ID=
# Resend → API Keys (only used when Telegram is not set).
RESEND_API_KEY=
# Where email notifications go.
NOTIFY_EMAIL=
# Optional sender. Default "DISPATCH <onboarding@resend.dev>" (only delivers to your own Resend account email).
NOTIFY_FROM=

# ── DISPATCH: Pinterest watcher ──────────────────────────────────────────────
# Comma-separated public board URLs holding only Emil's own work. Never the profile.
PINTEREST_BOARDS=

# ── DISPATCH: Are.na ─────────────────────────────────────────────────────────
# are.na/settings/personal-access-tokens → new token with the "write" scope.
ARENA_TOKEN=
# Slug of the channel to post into (the part after are.na/emil-lavinen/).
ARENA_CHANNEL=

# ── DISPATCH: X (developer console → your app → Keys and tokens) ────────────
# OAuth 1.0a: "API Key and Secret".
X_API_KEY=
X_API_SECRET=
# OAuth 1.0a: "Access Token and Secret", generated after "Read and write" is saved.
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# OAuth 2.0: "Client ID and Client Secret". Needed to connect X from /admin (uploads fallback, or instead of OAuth 1.0a).
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional, one-off: an existing OAuth 2.0 refresh token (offline.access). Used once if X was never connected in /admin; X rotates it on first use.
X_OAUTH2_REFRESH_TOKEN=
# true = add the work link to X posts. A post with a URL costs far more credits. Default false.
X_INCLUDE_LINK=false

# ── DISPATCH: Threads (developers.facebook.com → your app → Threads use case) ─
THREADS_APP_ID=
THREADS_APP_SECRET=

# ── DISPATCH: LinkedIn (linkedin.com/developers → your app → Auth) ──────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Posts API version, YYYYMM. Use a current one from learn.microsoft.com/linkedin (versions retire after ~1 year).
LINKEDIN_VERSION=

# ── DISPATCH: Bluesky ────────────────────────────────────────────────────────
# Your handle, e.g. emillavinen.bsky.social
BSKY_HANDLE=
# Bluesky → Settings → Privacy and security → App passwords.
BSKY_APP_PASSWORD=
# Optional: your PDS. Default https://bsky.social
BSKY_SERVICE=

# ── DISPATCH: Tumblr (tumblr.com/oauth/apps, then the API console for the user token) ─
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_TOKEN=
TUMBLR_TOKEN_SECRET=
# Blog name, e.g. emillavinen (or a full domain).
TUMBLR_BLOG=

# ── Existing site ────────────────────────────────────────────────────────────
# platform.openai.com/api-keys — SEO engine and content gap crons.
OPENAI_API_KEY=
# false disables the SEO engine cron.
SEO_ENGINE_ENABLED=true
# Public site URL for sitemap pings.
NEXT_PUBLIC_SITE_URL=https://emillavinen.com
# GitHub PAT with contents write — the blog posts admin.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
# Vercel → Settings → Git → Deploy Hooks — the posts admin's publish button.
VERCEL_DEPLOY_HOOK_URL=
