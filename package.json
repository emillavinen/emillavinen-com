    "openai": "6.45.0",
    "otpauth": "9.5.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "tiptap-markdown": "0.9.0",
    "twitter-text": "3.1.0"
